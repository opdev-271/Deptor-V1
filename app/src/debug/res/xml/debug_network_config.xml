<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug build umí mířit na lokální Firebase emulátor, který mluví plain HTTP.
  Výjimka je omezená na 10.0.2.2 a leží v debug source setu — release build
  cleartext nepovoluje.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
